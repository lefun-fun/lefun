{
  "name": "@lefun/ui",
  "version": "3.0.0-alpha.3",
  "description": "Main dependency for writing the UI of games at https://lefun.fun.",
  "author": "Simon Lemieux",
  "repository": {
    "type": "git",
    "url": "https://github.com/lefun-fun/lefun",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./lefunExtractor": {
      "import": "./dist/esm/lefunExtractor.js",
      "default": "./dist/esm/lefunExtractor.js",
      "types": "./dist/types/lefunExtractor.d.ts"
    }
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rm -rf ./dist",
    "compile": "rollup --config",
    "watch": "rollup --config --watch"
  },
  "dependencies": {
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@lefun/core": "workspace:*",
    "@lefun/game": "workspace:*",
    "@lingui/cli": "^6.0.1",
    "@lingui/conf": "^6.0.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rollup": "^4.60.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@lefun/core": "workspace:*",
    "@lefun/game": "workspace:*",
    "@lingui/cli": ">=6.0.0",
    "@lingui/conf": ">=6.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
