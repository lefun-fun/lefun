{
  "name": "@lefun/ui-testing",
  "version": "3.0.0-alpha.3",
  "description": "Utils for testing the UI of games at https://lefun.fun.",
  "author": "Simon Lemieux",
  "repository": {
    "type": "git",
    "url": "https://github.com/lefun-fun/lefun",
    "directory": "packages/ui-testing"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rm -rf ./dist",
    "compile": "esbuild src/index.tsx --bundle --format=esm --outdir=dist/esm --sourcemap --packages=external && tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.tsx --bundle --format=esm --outdir=dist/esm --sourcemap --packages=external --watch"
  },
  "dependencies": {
    "@testing-library/react": "^16.3.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@lefun/core": "workspace:*",
    "@lefun/game": "workspace:*",
    "@lefun/ui": "workspace:*",
    "@lingui/core": "^6.0.1",
    "@lingui/react": "^6.0.1",
    "@types/react": "^19.2.14",
    "esbuild": "^0.28.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@lefun/core": "workspace:*",
    "@lefun/game": "workspace:*",
    "@lefun/ui": "workspace:*",
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
