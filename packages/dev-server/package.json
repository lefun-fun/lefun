{
  "name": "@lefun/dev-server",
  "version": "3.0.0-alpha.3",
  "description": "Development server to run games developed for https://lefun.fun.",
  "author": "Simon Lemieux",
  "repository": {
    "type": "git",
    "url": "https://github.com/lefun-fun/lefun",
    "directory": "packages/dev-server"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rm -rf ./dist",
    "compile": "esbuild src/index.ts --bundle --format=esm --outdir=dist --sourcemap --packages=external && postcss src/index.css -o dist/index.css && tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.ts --bundle --format=esm --outdir=dist --sourcemap --packages=external --watch",
    "test": "pnpm vitest run src"
  },
  "devDependencies": {
    "@lefun/core": "workspace:*",
    "@lefun/game": "workspace:*",
    "@lefun/ui": "workspace:*",
    "@lingui/core": "^6.0.1",
    "@lingui/react": "^6.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.0",
    "postcss-cli": "^11.0.1",
    "postcss-nested": "^5.0.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^3.4.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@lefun/core": "workspace:*",
    "@lefun/game": "workspace:*",
    "@lefun/ui": "workspace:*",
    "@lingui/core": "^6.0.0",
    "@lingui/react": "^6.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "immer": "^11.1.8",
    "json-edit-react": "^1.29.1",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.13"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {},
      "autoprefixer": {},
      "postcss-nested": {}
    }
  }
}
