{
  "name": "@lefun/game",
  "version": "3.0.0-alpha.3",
  "description": "Main dependency for writing game logic at https://lefun.fun.",
  "author": "Simon Lemieux",
  "repository": {
    "type": "git",
    "url": "https://github.com/lefun-fun/lefun",
    "directory": "packages/game"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rm -rf ./dist",
    "compile": "esbuild src/index.ts --bundle --format=esm --outfile=dist/esm/index.js --sourcemap --external:@lefun/core && tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.ts --bundle --format=esm --outfile=dist/esm/index.js --sourcemap --external:@lefun/core --watch",
    "test": "vitest run src"
  },
  "devDependencies": {
    "@lefun/core": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "esbuild": "^0.25.12",
    "typescript": "^5.5.4",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "@lefun/core": "workspace:*"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "lodash-es": "^4.17.21"
  }
}
