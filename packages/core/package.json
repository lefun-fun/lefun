{
  "name": "@lefun/core",
  "version": "3.0.0-alpha.3",
  "description": "Core library to make games at https://lefun.fun",
  "author": "Simon Lemieux",
  "repository": {
    "type": "git",
    "url": "https://github.com/lefun-fun/lefun",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rm -rf ./dist",
    "compile": "esbuild src/index.ts --bundle --format=esm --outdir=dist/esm --sourcemap --packages=external && tsc --emitDeclarationOnly",
    "watch": "esbuild src/index.ts --bundle --format=esm --outdir=dist/esm --sourcemap --packages=external --watch",
    "test": "vitest run src"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
