{
  "name": "lefun-root",
  "version": "1.0.0",
  "description": "Public packages to create games for lefun.fun",
  "keywords": [],
  "author": "Simon Lemieux",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "fix-eslint": "pnpm eslint packages games --fix",
    "fix-prettier": "pnpm prettier --write .",
    "fix": "pnpm fix-eslint && pnpm fix-prettier",
    "check-prettier": "pnpm prettier --check .",
    "check-eslint": "pnpm eslint packages games --quiet",
    "check-types": "lerna exec --stream --parallel --no-bail -- tsc --skipLibCheck --pretty --noEmit",
    "check": "pnpm check-eslint && pnpm check-prettier && pnpm check-types"
  },
  "dependencies": {
    "lerna": "^9.0.7"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.15.0"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.1.3"
    }
  }
}
